---
import { styles } from '../data/themes';

// Filter down to the 6 most distinct vibes to showcase on-page
const featuredStyles = styles.filter(s => 
  ['aurora', 'brutalist', 'editorial', 'neon', 'bento', 'cyber'].includes(s.id)
);

// Map static theme parameters for preview mockups on-page
const previewParams: Record<string, { bg: string; border: string; accent: string; label: string; text: string }> = {
  aurora: { bg: '#050505', border: '1px solid rgba(255,255,255,0.09)', accent: 'linear-gradient(135deg,#6ceaff,#a78bfa,#ff6ec7)', label: 'Aurora Glass', text: '#f4f4f6' },
  brutalist: { bg: '#f0f0f0', border: '2px solid #111', accent: '#0000ff', label: 'Brutalist', text: '#111' },
  editorial: { bg: '#fbf9f4', border: '1px solid #e5dfd3', accent: '#c95a49', label: 'Editorial', text: '#2c2a29' },
  neon: { bg: '#020204', border: '1px solid rgba(0,245,255,0.25)', accent: '#ff6ec7', label: 'Neon Noir', text: '#00f5ff' },
  bento: { bg: '#0a0a0d', border: '1px solid rgba(255,255,255,0.06)', accent: 'linear-gradient(135deg,#ff9966,#ff5e62)', label: 'Bento', text: '#e0e0e3' },
  cyber: { bg: '#000a06', border: '1px dashed #00ff9f', accent: '#00ff9f', label: 'Cyberdeck', text: '#00ff9f' },
};
---

<div class="vibe-studio">
  <div class="vibe-grid">
    {featuredStyles.map(s => {
      const p = previewParams[s.id] || previewParams.aurora;
      return (
        <button 
          class="vibe-card glass" 
          data-vibe={s.id}
          aria-label={`Switch style to ${s.label}`}
          data-reveal
        >
          <!-- Mockup visual header -->
          <div class="vibe-card__preview" style={`background: ${p.bg}; border-bottom: ${p.border};`}>
            <div class="vibe-card__ui">
              <!-- Window dots -->
              <div class="vibe-card__dots">
                <span style={`background: ${s.id === 'brutalist' ? '#111' : '#ff5f56'}`}></span>
                <span style={`background: ${s.id === 'brutalist' ? '#111' : '#ffbd2e'}`}></span>
                <span style={`background: ${s.id === 'brutalist' ? '#111' : '#27c93f'}`}></span>
              </div>
              <!-- Text bar -->
              <div class="vibe-card__bar" style={`background: ${s.id === 'editorial' ? '#e8e2d4' : 'rgba(255,255,255,0.06)'}; border: ${p.border};`}></div>
            </div>
            
            <!-- Graphic layout -->
            <div class="vibe-card__graphic">
              <div class="vibe-card__circle" style={`background: ${p.accent}; box-shadow: ${s.id === 'neon' || s.id === 'cyber' ? `0 0 16px ${p.accent}` : 'none'};`}></div>
              <div class="vibe-card__lines">
                <div class="vibe-card__line" style={`background: ${p.text}; opacity: 0.8; width: 60%;`}></div>
                <div class="vibe-card__line" style={`background: ${p.text}; opacity: 0.4; width: 40%;`}></div>
              </div>
            </div>
          </div>
          
          <!-- Content info -->
          <div class="vibe-card__body">
            <div class="vibe-card__meta">
              <h3 class="vibe-card__title display">{s.label}</h3>
              <span class="vibe-card__badge font-mono">{s.id.toUpperCase()}</span>
            </div>
            <p class="vibe-card__note">{s.note}</p>
            <div class="vibe-card__action font-mono">
              <span class="vibe-card__btn-txt">Apply styling</span>
              <span class="vibe-card__indicator"></span>
            </div>
          </div>
        </button>
      );
    })}
  </div>
</div>

<style>
  .vibe-studio {
    width: 100%;
    margin-top: 1.5rem;
  }

  .vibe-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 1.4rem;
  }

  /* Core Card Layout */
  .vibe-card {
    text-align: left;
    display: flex;
    flex-direction: column;
    padding: 0;
    overflow: hidden;
    cursor: pointer;
    color: var(--text);
    transition: transform 0.3s var(--ease), border-color 0.3s var(--ease), box-shadow 0.3s var(--ease);
  }
  .vibe-card:hover {
    transform: translateY(-4px);
    border-color: var(--border-bright);
  }

  /* Preview area representing mockup style */
  .vibe-card__preview {
    height: 120px;
    position: relative;
    padding: 0.8rem;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    transition: background 0.3s ease;
  }

  .vibe-card__ui {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }

  .vibe-card__dots {
    display: flex;
    gap: 3px;
  }
  .vibe-card__dots span {
    width: 5px;
    height: 5px;
    border-radius: 50%;
  }

  .vibe-card__bar {
    height: 8px;
    border-radius: 3px;
    flex: 1;
    max-width: 80px;
  }

  .vibe-card__graphic {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    margin-bottom: 0.5rem;
  }

  .vibe-card__circle {
    width: 28px;
    height: 28px;
    border-radius: 50%;
    flex-shrink: 0;
  }

  /* Custom geometry mockups based on vibe */
  [data-vibe="brutalist"] .vibe-card__circle {
    border-radius: 0;
    border: 2px solid #111;
  }
  [data-vibe="cyber"] .vibe-card__circle {
    border-radius: 2px;
  }

  .vibe-card__lines {
    display: flex;
    flex-direction: column;
    gap: 4px;
    flex: 1;
  }

  .vibe-card__line {
    height: 4px;
    border-radius: 1px;
  }

  /* Card Body & Information */
  .vibe-card__body {
    padding: 1.2rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    background: transparent;
    flex: 1;
  }

  .vibe-card__meta {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 0.5rem;
  }

  .vibe-card__title {
    font-size: 1.15rem;
  }

  .vibe-card__badge {
    font-size: 0.62rem;
    color: var(--accent);
    letter-spacing: 0.05em;
    opacity: 0.8;
  }

  .vibe-card__note {
    font-size: 0.84rem;
    color: var(--text-dim);
    line-height: 1.45;
    flex: 1;
  }

  .vibe-card__action {
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-size: 0.72rem;
    letter-spacing: 0.06em;
    color: var(--text-dim);
    border-top: 1px solid var(--border);
    padding-top: 0.8rem;
    margin-top: 0.4rem;
    transition: color 0.2s;
  }

  .vibe-card__indicator {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--border);
    transition: background 0.3s ease, box-shadow 0.3s ease;
  }

  /* Hover and active states */
  .vibe-card:hover .vibe-card__action {
    color: var(--text);
  }

  /* Active theme state */
  .vibe-card.is-active {
    border-color: var(--accent);
    box-shadow: 0 10px 30px var(--accent-soft);
  }
  .vibe-card.is-active .vibe-card__indicator {
    background: var(--accent);
    box-shadow: 0 0 10px var(--accent);
  }
  .vibe-card.is-active .vibe-card__btn-txt {
    color: var(--accent);
  }

  /* Brutalist theme adaptations */
  :root[data-style="brutalist"] .vibe-card {
    border: 2px solid var(--text) !important;
    border-radius: 0 !important;
  }
  :root[data-style="brutalist"] .vibe-card.is-active {
    box-shadow: 5px 5px 0 var(--text) !important;
  }
</style>

<script>
  // Script logic to coordinate with the global design console __wsTheme state
  const cards = document.querySelectorAll('.vibe-card');

  // Sync active states on load and change
  function syncActiveCard() {
    const currentStyle = document.documentElement.getAttribute('data-style') || 'aurora';
    cards.forEach(card => {
      const vibe = card.getAttribute('data-vibe');
      if (vibe === currentStyle) {
        card.classList.add('is-active');
      } else {
        card.classList.remove('is-active');
      }
    });
  }

  // Set click listeners to switch style
  cards.forEach(card => {
    card.addEventListener('click', () => {
      const vibe = card.getAttribute('data-vibe');
      if (vibe && window.__wsTheme) {
        // Apply target style mode
        window.__wsTheme.setStyle(vibe);
        
        // Match accent styles based on typical pairings in themes.ts
        if (vibe === 'editorial') {
          window.__wsTheme.setAccent(3); // Gold
          window.__wsTheme.setFont(1); // Sentient
          window.__wsTheme.setOpt('bg', 'none');
          window.__wsTheme.setOpt('banner', 'off');
        } else if (vibe === 'brutalist') {
          window.__wsTheme.setAccent(4); // Electric
          window.__wsTheme.setFont(3); // Array
          window.__wsTheme.setOpt('corners', 'sharp');
          window.__wsTheme.setOpt('bg', 'grid');
        } else if (vibe === 'neon') {
          window.__wsTheme.setAccent(0); // Spectrum
          window.__vibe_neon_glow = true;
          window.__wsTheme.setFont(4); // Segment
          window.__wsTheme.setOpt('hero', 'glow');
          window.__wsTheme.setOpt('cursor', 'ring');
        } else if (vibe === 'cyber') {
          window.__wsTheme.setAccent(5); // Mono
          window.__wsTheme.setFont(3); // Array
          window.__wsTheme.setOpt('bg', 'dots');
          window.__wsTheme.setOpt('crt', 'on');
          window.__wsTheme.setOpt('cards', 'outline');
        } else if (vibe === 'bento') {
          window.__wsTheme.setAccent(1); // Sunset
          window.__wsTheme.setFont(2); // Alpino
          window.__wsTheme.setOpt('cards', 'elevated');
        } else {
          // Aurora
          window.__wsTheme.setAccent(0); // Spectrum
          window.__wsTheme.setFont(0); // Satoshi
          window.__wsTheme.setOpt('bg', 'particles');
          window.__wsTheme.setOpt('corners', 'round');
          window.__wsTheme.setOpt('crt', 'off');
          window.__wsTheme.setOpt('cards', 'glass');
        }

        // Sync card classes
        syncActiveCard();
      }
    });
  });

  // Observe HTML element mutations to keep card in sync if user changes style in the float console
  const observer = new MutationObserver(syncActiveCard);
  observer.observe(document.documentElement, { attributes: true, attributeFilter: ['data-style'] });

  // Initial sync
  setTimeout(syncActiveCard, 100);
</script>
