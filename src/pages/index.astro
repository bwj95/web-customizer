---
import Base from '../layouts/Base.astro';
import Marquee from '../components/Marquee.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { site, offerings, showcase } from '../data/site';
import { byKind } from '../data/projects';

const features = byKind('flagship');
---
<Base>
  <!-- ============ HERO ============ -->
  <section class="hero wrap">
    <p class="eyebrow" data-reveal>{site.role}</p>
    <h1 class="hero__title font-hero" data-reveal style="--reveal-delay:80ms">
      Your site, <span class="gradient-text">any style</span>
      <br class="hero__br" />you can imagine.
    </h1>
    <p class="lead hero__lead" data-reveal style="--reveal-delay:160ms">
      Don't take our word for it — <strong>take the controls.</strong> This whole page is a
      live demo. Open the Design Console and restyle it — fonts, colors, layout, the entire
      vibe — in real time. That's the promise: your site, built exactly how you picture it.
    </p>
    <div class="hero__cta" data-reveal style="--reveal-delay:240ms">
      <button class="btn btn-primary" data-open-console>✦ Design this page live</button>
      <a class="btn btn-ghost" href="#hire">See pricing →</a>
    </div>
  </section>

  <Marquee items={site.stack} />

  <!-- ============ WHAT YOU CAN CUSTOMIZE ============ -->
  <section id="work" class="section wrap">
    <header class="sec-head" data-reveal>
      <p class="eyebrow">01 — Customize</p>
      <h2 class="sec-head__title display">Everything is a knob.</h2>
      <p class="lead">These cards restyle with the site. Open the console and try any of it — this is exactly what you'd get.</p>
    </header>
    <div class="grid">
      {features.map((p) => <ProjectCard project={p} />)}
    </div>
  </section>

  <!-- ============ PRICING ============ -->
  <section id="hire" class="section wrap">
    <header class="sec-head" data-reveal>
      <p class="eyebrow">02 — Pricing</p>
      <h2 class="sec-head__title display">Ready to make it yours?</h2>
      <p class="lead">Pick a look, we build it. Straight talk, fast turnaround, and you own everything at the end.</p>
    </header>

    <div class="offer-grid">
      {offerings.map((o) => (
        <article class="offer glass" data-reveal>
          <div class="offer__top">
            <h3 class="offer__title display">{o.title}</h3>
            <span class="offer__price">{o.price}</span>
          </div>
          <p class="offer__blurb">{o.blurb}</p>
          <a class="offer__cta" href={`mailto:${site.email}?subject=${encodeURIComponent(o.cta)}`}>
            {o.cta} <span aria-hidden="true">→</span>
          </a>
        </article>
      ))}
    </div>

    <div class="contact glass" data-reveal>
      <div>
        <h3 class="display contact__h">Have something in mind?</h3>
        <p class="contact__p">Tell us what you're building — or just play with the console first.</p>
      </div>
      <div class="contact__actions">
        <a class="btn btn-primary" href={`mailto:${site.email}?subject=${encodeURIComponent('Project inquiry')}`}>Get in touch</a>
        <button class="btn btn-ghost" data-open-console>Open the customizer</button>
      </div>
    </div>
  </section>

  <!-- ============ EXAMPLES (resource links) ============ -->
  <section id="examples" class="section wrap">
    <header class="sec-head" data-reveal>
      <p class="eyebrow">03 — Examples</p>
      <h2 class="sec-head__title display">Sites built with this.</h2>
      <p class="lead">A few live sites using these building blocks. More coming.</p>
    </header>
    <div class="links-grid">
      {showcase.map((s) => (
        <a class="reslink glass" href={s.href} target="_blank" rel="noopener" data-reveal>
          <span class="reslink__name display">{s.name}</span>
          <span class="reslink__note">{s.note}</span>
          <span class="reslink__go" aria-hidden="true">Visit ↗</span>
        </a>
      ))}
    </div>
  </section>
</Base>

<style>
  .hero { padding-top: clamp(1rem, 4vw, 3rem); padding-bottom: clamp(2.5rem, 6vw, 4rem); }
  .hero__title { font-size: clamp(2.4rem, 7.2vw, 5.4rem); margin-top: 1.2rem; max-width: 16ch; }
  .hero__lead { margin-top: 1.6rem; }
  .hero__cta { display: flex; flex-wrap: wrap; gap: 0.9rem; margin-top: 2.2rem; }
  @media (max-width: 640px) { .hero__br { display: none; } }

  .sec-head { max-width: 60ch; margin-bottom: clamp(2rem, 5vw, 3.2rem); display: flex; flex-direction: column; gap: 0.7rem; }
  .sec-head__title { font-size: clamp(1.8rem, 4.6vw, 3rem); }

  .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(320px, 1fr)); gap: 1.4rem; }

  .offer-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 1.2rem; }
  .offer { padding: 1.6rem; display: flex; flex-direction: column; gap: 0.9rem; transition: transform 0.3s var(--ease), border-color 0.3s var(--ease); }
  .offer:hover { transform: translateY(-3px); border-color: var(--border-bright); }
  .offer__top { display: flex; align-items: baseline; justify-content: space-between; gap: 1rem; }
  .offer__title { font-size: 1.25rem; }
  .offer__price { font-family: var(--font-mono); font-size: 0.78rem; color: var(--accent); white-space: nowrap; }
  .offer__blurb { color: var(--text-dim); font-size: 0.92rem; line-height: 1.55; flex: 1; }
  .offer__cta { font-family: var(--font-mono); font-size: 0.84rem; color: var(--text); }
  .offer__cta:hover { color: var(--accent); }

  .contact { margin-top: 1.4rem; padding: clamp(1.6rem, 4vw, 2.6rem); display: flex; flex-wrap: wrap; gap: 1.5rem; align-items: center; justify-content: space-between; background: var(--spectrum-soft); }
  .contact__h { font-size: clamp(1.4rem, 3.5vw, 2rem); }
  .contact__p { color: var(--text-dim); margin-top: 0.4rem; }
  .contact__actions { display: flex; flex-wrap: wrap; gap: 0.8rem; }

  .links-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); gap: 1rem; }
  .reslink { display: flex; flex-direction: column; gap: 0.35rem; padding: 1.4rem 1.5rem; transition: transform 0.3s var(--ease), border-color 0.3s var(--ease); }
  .reslink:hover { transform: translateY(-3px); border-color: var(--border-bright); }
  .reslink__name { font-size: 1.3rem; }
  .reslink__note { color: var(--text-dim); font-size: 0.9rem; flex: 1; }
  .reslink__go { font-family: var(--font-mono); font-size: 0.78rem; color: var(--accent); margin-top: 0.5rem; }
</style>
